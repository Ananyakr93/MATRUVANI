# ── Server ────────────────────────────────────────────────────────────────────
# Port for the FastAPI/uvicorn server (use 8001 if 8000 is occupied)
PORT=8001

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for local dev — file is created automatically)
DATABASE_URL=sqlite:///./matruvani.db

# PostgreSQL example (uncomment for production):
# DATABASE_URL=postgresql://matruvani:matruvani@localhost:5432/matruvani

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
MSG91_API_KEY=xxxxx

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
